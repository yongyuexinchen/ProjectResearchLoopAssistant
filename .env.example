# ---------------------------------------------------------------------------
# Project Research Loop Assistant - local configuration sample
#
# Copy this file to `.env` in the repository root, then fill in your own values.
# `.env` is intentionally ignored by Git. Never commit real passwords or API keys.
# ---------------------------------------------------------------------------

# Required: MySQL / SQLAlchemy connection string.
# Create the database first:
#   CREATE DATABASE loop_engineering CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://root:<local-password>@127.0.0.1:3306/loop_engineering

# Required: where cloned repositories and collected workspaces are stored.
# Relative paths are resolved from the repository root.
WORKSPACE_ROOT=./workspace/projects

# Required by the Next.js frontend: backend origin used by the same-origin proxy.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8002

# LLM provider (OpenAI-compatible endpoint).
# Use deepseek, qwen, vllm, or openai-compatible.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY_REQUIRED=true
LLM_TIMEOUT_SECONDS=30

# Optional scanner limits (defaults shown).
# SOURCE_MAX_FILE_BYTES=1000000
# SOURCE_EXCERPT_CHARS=4000
# WEB_FETCH_TIMEOUT_SECONDS=20
# Set true only when you intentionally collect private/intranet documentation.
# WEB_ALLOW_PRIVATE_HOSTS=false
# GIT_CLONE_TIMEOUT_SECONDS=120
